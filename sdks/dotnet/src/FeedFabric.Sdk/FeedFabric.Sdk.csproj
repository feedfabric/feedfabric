<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>FeedFabric.Sdk</PackageId>
    <Version>0.1.0</Version>
    <Description>Call FeedFabric from your servers, for your members, with an API key.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>feedfabric;feed;social</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Not every member needs a summary -->
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FeedFabric.Sdk.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
