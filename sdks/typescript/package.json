{
  "name": "@feedfabric/sdk",
  "version": "0.1.0",
  "description": "FeedFabric for your servers: posts, feeds, comments, signals and typed post data, with an API key",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "files": ["dist"],
  "engines": { "node": ">=20" },
  "repository": { "type": "git", "url": "git+https://github.com/feedfabric/feedfabric.git", "directory": "sdks/typescript" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test test/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "6.0.3"
  }
}
