{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 1048576
    }
  },
  "Auth": {
    "Mode": "Jwt",
    "Jwt": {
      "Authority": "",
      "Audience": "",
      "Issuer": "",
      "SigningKey": ""
    },
    "Claims": {
      "UserId": "sub",
      "Avatar": "picture"
    },
    "ProvisionUsers": true
  }
}
