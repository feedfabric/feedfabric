{
  "name": "@feedfabric/fabric-ui",
  "private": true,
  "type": "module",
  "description": "FabricUI: FeedFabric's Vue 3 components and design tokens",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/fabric.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "jsdom": "31.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "vue": "3.5.44",
    "vue-tsc": "3.3.14"
  }
}
