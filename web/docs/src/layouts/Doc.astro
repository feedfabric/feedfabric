---
// Every page: header, sidebar, the page itself, an "On this page" list and links to the previous and next pages.
// Markdown pages use it through `layout:` in their frontmatter; .astro pages pass title, description and headings.
import '../../../fabric-ui/src/styles/fabric.css'
import '../styles/docs.css'
import { nav, pages, normalise } from '../nav'

interface Heading { depth: number; slug: string; text: string }
interface Props {
  frontmatter?: { title: string; description?: string }
  title?: string
  description?: string
  headings?: Heading[]
}

const { frontmatter, headings = [] } = Astro.props
const title = frontmatter?.title ?? Astro.props.title ?? 'FeedFabric'
const description = frontmatter?.description ?? Astro.props.description ?? ''
const path = normalise(Astro.url.pathname)
const index = pages.findIndex(p => p.href === path)
const prev = index > 0 ? pages[index - 1] : undefined
const next = index >= 0 && index < pages.length - 1 ? pages[index + 1] : undefined
const toc = headings.filter(h => h.depth === 2 || h.depth === 3)
const pageTitle = path === '/' ? 'FeedFabric docs' : `${title} · FeedFabric docs`
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Before anything paints: a theme chosen on this site wins over the system's -->
    <script is:inline>
      try {
        const theme = localStorage.getItem('feedfabric.docs.theme')
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme
      } catch {}
    </script>
  </head>
  <body class="fabric">
    <a class="skip" href="#content">Skip to content</a>
    <header class="topbar">
      <button class="nav-toggle" type="button" aria-controls="sidebar" aria-expanded="false" aria-label="Open the menu">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
      </button>
      <a class="brand" href="/">
        <img src="/favicon.svg" width="28" height="28" alt="" />
        <span>FeedFabric <span class="brand-sub">docs</span></span>
      </a>
      <button class="theme-toggle" type="button" aria-label="Theme: follows your system. Change it">
        <svg class="icon-system" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2" /><path d="M8 20h8M12 16v4" /></svg>
        <svg class="icon-light" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
        <svg class="icon-dark" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" /></svg>
        <span class="theme-label">System</span>
      </button>
    </header>

    <div class="frame">
      <nav id="sidebar" class="sidebar" aria-label="Documentation">
        {nav.map(section => (
          <div class="nav-section">
            <p class="nav-title">{section.title}</p>
            <ul>
              {section.links.map(link => (
                <li>
                  <a href={link.href} aria-current={link.href === path ? 'page' : undefined}>{link.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
      <div class="scrim" hidden></div>

      <main id="content" class="content" tabindex="-1">
        <article class="prose">
          <h1>{title}</h1>
          {description && <p class="lede">{description}</p>}
          <slot />
        </article>

        {(prev || next) && (
          <nav class="pager" aria-label="Previous and next pages">
            {prev ? <a class="prev" href={prev.href}><span>Previous</span>{prev.label}</a> : <span />}
            {next ? <a class="next" href={next.href}><span>Next</span>{next.label}</a> : <span />}
          </nav>
        )}
        <footer class="foot">
          FeedFabric is MIT licensed. These pages are built from <code>web/docs</code>; the repository's own
          <code>docs/</code> folder has the full configuration, data model and error lists.
        </footer>
      </main>

      {toc.length > 1 && (
        <aside class="toc" aria-label="On this page">
          <p class="nav-title">On this page</p>
          <ul>
            {toc.map(h => (
              <li class={`depth-${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>
            ))}
          </ul>
        </aside>
      )}
    </div>

    <script>
      // Theme: system → light → dark → system, remembered in this browser only
      const order = ['system', 'light', 'dark'] as const
      type Choice = (typeof order)[number]
      const labels: Record<Choice, string> = { system: 'System', light: 'Light', dark: 'Dark' }
      const root = document.documentElement
      const themeButton = document.querySelector<HTMLButtonElement>('.theme-toggle')!
      const current = (): Choice => (root.dataset.theme === 'light' || root.dataset.theme === 'dark' ? root.dataset.theme : 'system')

      function show(choice: Choice) {
        themeButton.dataset.choice = choice
        themeButton.querySelector('.theme-label')!.textContent = labels[choice]
        themeButton.setAttribute('aria-label', `Theme: ${choice === 'system' ? 'follows your system' : labels[choice].toLowerCase()}. Change it`)
      }

      themeButton.addEventListener('click', () => {
        const choice = order[(order.indexOf(current()) + 1) % order.length]
        if (choice === 'system') delete root.dataset.theme
        else root.dataset.theme = choice
        try {
          if (choice === 'system') localStorage.removeItem('feedfabric.docs.theme')
          else localStorage.setItem('feedfabric.docs.theme', choice)
        } catch {
          // Private windows can refuse storage; the choice just won't survive a reload
        }
        show(choice)
      })
      show(current())

      // The sidebar folds into a menu at phone width
      const navButton = document.querySelector<HTMLButtonElement>('.nav-toggle')!
      const scrim = document.querySelector<HTMLElement>('.scrim')!
      function setOpen(open: boolean) {
        document.body.classList.toggle('nav-open', open)
        navButton.setAttribute('aria-expanded', String(open))
        navButton.setAttribute('aria-label', open ? 'Close the menu' : 'Open the menu')
        scrim.hidden = !open
      }
      navButton.addEventListener('click', () => setOpen(!document.body.classList.contains('nav-open')))
      scrim.addEventListener('click', () => setOpen(false))
      document.addEventListener('keydown', e => e.key === 'Escape' && document.body.classList.contains('nav-open') && (setOpen(false), navButton.focus()))
    </script>
  </body>
</html>
