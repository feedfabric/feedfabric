{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "jsx": "preserve",
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [],
    // FabricUI from source; its files use this app's Vue, so the admin build doesn't need FabricUI's node_modules
    "paths": {
      "@feedfabric/fabric-ui": ["../fabric-ui/src/index.ts"],
      "vue": ["./node_modules/vue"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "../fabric-ui/src/**/*.ts", "../fabric-ui/src/**/*.vue"]
}
